# Public browser/build configuration
VITE_POSTHOG_KEY=phc_your-project-token
VITE_POSTHOG_HOST=https://your-posthog-host.example
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_WEBHOOK_URL=https://your-webhook.example

# Local development draft preview only. Keep these names unprefixed.
# BLOG_PREVIEW_HOST must be the exact browser origin, with no path.
BLOG_PREVIEW_HOST=https://your-device.your-tailnet.ts.net
SUPABASE_SECRET_KEY=your-supabase-secret-key
BLOG_PREVIEW_KEY=generate-at-least-16-random-characters
BLOG_PREVIEW_SESSION_SECRET=generate-at-least-32-random-characters
